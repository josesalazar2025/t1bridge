[Unit]
Description=T1Bridge automatic Apple machine-data import
After=systemd-tmpfiles-setup.service systemd-udev-trigger.service

[Service]
Type=oneshot
ExecStart=/usr/bin/t1bridge machine-data import
User=root
Group=root
UMask=0077
TimeoutStartSec=90
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN
PrivateMounts=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=block-* r
DeviceAllow=char-usb_device rw
ProtectHome=yes
ProtectSystem=strict
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RemoveIPC=yes
RestrictAddressFamilies=AF_INET6 AF_NETLINK
RestrictNamespaces=mnt
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/t1bridge/machine-data
ReadWritePaths=/run/lock/t1-touchid-sep.lock
