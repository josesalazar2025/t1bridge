[Unit]
Description=T1Bridge Touch ID authentication broker
Requires=t1-touchid-auth.socket t1bridge-fingerprint.socket
After=t1-touchid-auth.socket t1bridge-fingerprint.socket t1bridge-keybag.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/lib/t1bridge/t1-touchid-auth
Sockets=t1-touchid-auth.socket t1bridge-fingerprint.socket
User=root
Group=root
UMask=0077
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
RemoveIPC=yes
ProtectHome=yes
ProtectSystem=strict
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
DevicePolicy=closed
DeviceAllow=char-usb_device rw
ReadWritePaths=/var/lib/t1bridge/touch-id
ReadWritePaths=/run/lock/t1-touchid-sep.lock
ReadWritePaths=-/run/t1bridge
