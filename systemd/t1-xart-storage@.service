[Unit]
Description=T1Bridge xART storage for dynamic T1 NCM device
BindsTo=sys-subsystem-net-devices-%i.device
Requires=t1-ncm-ready@%i.service
After=sys-subsystem-net-devices-%i.device systemd-tmpfiles-setup.service t1-ncm-ready@%i.service
Wants=t1bridge-keybag.service
Before=t1bridge-keybag.service
PropagatesStopTo=t1bridge-keybag.service

[Service]
EnvironmentFile=-/etc/t1bridge/diagnostics.conf
Type=notify
NotifyAccess=main
ExecStart=/usr/lib/t1bridge/t1-xart-storage
User=root
Group=root
UMask=0077
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=
PrivateTmp=yes
DevicePolicy=closed
ProtectHome=yes
ProtectSystem=strict
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RemoveIPC=yes
RestrictAddressFamilies=AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/t1bridge/touch-id/xart
