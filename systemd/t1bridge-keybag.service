[Unit]
Description=T1Bridge existing-keybag notification relay
ConditionPathExists=/var/lib/t1bridge/touch-id/keybag.state

[Service]
EnvironmentFile=-/etc/t1bridge/diagnostics.conf
Type=notify
NotifyAccess=main
ExecCondition=/usr/bin/systemctl --quiet is-active t1-xart-storage@*.service
ExecStart=/usr/lib/t1bridge/t1-keybag-relay
User=root
Group=root
UMask=0077
Restart=on-failure
RestartSec=2
TimeoutStartSec=35
TimeoutStopSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateNetwork=yes
RemoveIPC=yes
ProtectHome=yes
ProtectSystem=strict
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
DevicePolicy=closed
DeviceAllow=char-usb_device rw
ReadOnlyPaths=/var/lib/t1bridge/touch-id/keybag.state
ReadWritePaths=/run/lock/t1-touchid-sep.lock

[Install]
WantedBy=multi-user.target
